# Copy to .env for a local run. Never commit .env. These values are dev only.

TILL_DATABASE_URL=postgres://till:till@127.0.0.1:5432/till?sslmode=disable
TILL_HTTP_ADDR=:8080

# At least 32 characters. Rotate before any real deployment.
TILL_JWT_SECRET=dev-only-change-me-use-32chars-min!!

# At least 16 characters. This signs the mock Paystack webhook. It is not a live Paystack key.
TILL_PAYSTACK_SECRET=dev-paystack-secret

# Seed Adaeze Studio (Ikeja + Surulere) on boot. Idempotent.
TILL_SEED=true
TILL_SEED_PASSWORD=change-me-now-12

# How long a transfer holds stock. 1 to 1440 minutes. Default 15.
TILL_HOLD_MINUTES=15

# development (default) or production. Production refuses the example secrets above,
# secrets shorter than 48 (JWT) / 24 (Paystack) characters, and TILL_SEED=true.
TILL_ENV=development

# Access token lifetime (Go duration, 1m to 720h). Default 8h.
TILL_TOKEN_TTL=8h

# Comma-separated browser origins allowed to call the API. Empty disables CORS.
TILL_CORS_ORIGINS=

# Set true only behind a reverse proxy you control: rate limits then key on the last
# X-Forwarded-For entry instead of the socket address.
TILL_TRUST_PROXY=false

# Login attempts per minute per IP (default 30) and per email (default 6, burst 12).
# Limits are in memory and per instance. Lockout after 10 failures in 15 minutes is in Postgres.
TILL_LOGIN_RATE_IP=30
TILL_LOGIN_RATE_EMAIL=6
